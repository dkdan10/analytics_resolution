# Bulk NBA data is never committed (data rights; see README.md, Data & license).
# Derived data in data/processed/ IS committed.
data/shots/
data/raw/

# Per-game window intermediates: bulky, and they carry the frame-level approach
# curves that never leave this machine. Only the reduced artifacts in
# data/processed/ ship.
data/window/

__pycache__/
*.pyc
.DS_Store
node_modules/
dist/
.venv/

# Synced copy of data/processed/ (regenerated by site/scripts/sync-data.mjs).
site/public/data/

# Local working notes and tool state. Never committed. The gate reads the first
# two where present (qa.MEMORY_DOCS); the generated scalar disclosure is the one
# document kept under docs/.
/CLAUDE.md
/DEPLOY.md
/.claude/
/paper/
/docs/*
!/docs/material-scalars.md
