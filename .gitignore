# Bulk NBA data is never committed (data rights - see CLAUDE.md).
# Derived JSON in data/processed/ IS committed.
data/shots/
data/raw/

# Per-game window intermediates: bulky, and they carry the frame-level approach
# curves that never leave this machine. Only the reduced artifacts in
# data/processed/ (window.json, window_measures.bin) ship.
data/window/

__pycache__/
*.pyc
.DS_Store
node_modules/
dist/

# Synced copy of data/processed/ (regenerated by site/scripts/sync-data.mjs).
site/public/data/

docs/audits/

# Frames rendered by site/scripts/shots.mjs for LOOKING at. Regenerable from any
# commit at an exact t, a couple of megabytes each, and not evidence of
# anything - docs/build/probe/ is where a verdict goes.
docs/shots/

# Session prompts for the audit remediation (working documents).
docs/prompts/

# The paper: working notes and the built manuscript.
docs/paper/
paper/

# Planning documents. These steered the build; they are not what a reader of the
# finished project needs, and they stay on disk rather than in the tree.
# docs/build/findings.md is the exception and stays TRACKED - it is gate input
# (most of qa.py's MEMORY_CLAIMS resolve only there), not an archive.
docs/build-plan-v2.md
docs/thesis-and-course-resources.md
docs/build/session-*-packet.md
docs/build/session-*-handoff.md

# Probe verdicts: machine output, regenerable with `npm run probe:purity` and
# `npm run probe:perf`. docs/probe/ is where a run lands (probe-run.mjs:OUT_DIR);
# docs/build/probe/ was the committed archive.
docs/probe/
docs/build/probe/

# Local tool state. .claude/launch.json IS committed - it is how the dev server
# is started for the browser probes, and it belongs with them.
.claude/*
!.claude/launch.json
